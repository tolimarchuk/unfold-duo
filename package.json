{
  "name": "unfold-device",
  "version": "0.1.0",
  "description": "iPhone Duo in HTML and CSS 3D: open it, fold it, turn it and pose it. One file, no dependencies.",
  "homepage": "https://unfold.foo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolimarchuk/unfold-duo.git"
  },
  "bugs": {
    "url": "https://github.com/tolimarchuk/unfold-duo/issues"
  },
  "type": "module",
  "main": "unfold.js",
  "exports": {
    ".": "./unfold.js"
  },
  "files": [
    "unfold.js"
  ],
  "sideEffects": true,
  "scripts": {
    "site": "rm -rf dist && mkdir dist && cp -R index.html 404.html og.png _headers unfold.js demo dist/",
    "deploy": "npm run site && cf deploy"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "css-3d",
    "iphone-duo",
    "foldable",
    "mockup",
    "device-frame"
  ],
  "author": "Toli Marchuk (https://heysigna.com)",
  "license": "MIT",
  "devDependencies": {
    "cf": "^1.0.0-beta.21",
    "wrangler": "^4.152.0"
  }
}
